<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Description>An extremely easy to use Micro-ORM supporting Sql Server.</Description>
	<VersionPrefix>6.4.0</VersionPrefix>
	<TargetFrameworks>net462;netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
	<AssemblyName>NPoco.SqlServer</AssemblyName>
	<PackageId>NPoco.SqlServer</PackageId>
	<Authors>Adam Schröder</Authors>
	<PackageTags>orm;sql;micro-orm;database;mvc</PackageTags>
	<PackageProjectUrl>https://github.com/schotime/NPoco</PackageProjectUrl>
    <LangVersion>latest</LangVersion>
	<nullable>enable</nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="Polly" Version="8.5.0" />
  </ItemGroup>

  <!-- Pin patched versions of the transitive Microsoft.Data.SqlClient dependency (CVE-2026-84008, CVE-2026-70162) -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NPoco\NPoco.csproj" />
  </ItemGroup>

</Project>

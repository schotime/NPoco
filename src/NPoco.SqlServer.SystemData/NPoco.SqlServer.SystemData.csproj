<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	<Description>An extremely easy to use Micro-ORM supporting Sql Server.</Description>
	<VersionPrefix>6.2.0</VersionPrefix>
	<TargetFrameworks>net462;netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
	<AssemblyName>NPoco.SqlServer.SystemData</AssemblyName>
	<PackageId>NPoco.SqlServer.SystemData</PackageId>
	<Authors>Adam Schröder</Authors>
	<PackageTags>orm;sql;micro-orm;database;mvc</PackageTags>
	<PackageProjectUrl>https://github.com/schotime/NPoco</PackageProjectUrl>
	<LangVersion>latest</LangVersion>
	<nullable>enable</nullable>
	<!-- This project's whole purpose is to target the legacy System.Data.SqlClient provider,
	     whose types are marked [Obsolete] pointing at Microsoft.Data.SqlClient. That's expected
	     here, not a bug to fix - NPoco.SqlServer is the Microsoft.Data.SqlClient variant. -->
	<NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NPoco\NPoco.csproj" />
  </ItemGroup>

  <ItemGroup>
	<PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
	<PackageReference Include="Polly" Version="8.5.0" />
  </ItemGroup>

</Project>
